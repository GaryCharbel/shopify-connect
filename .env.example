# --- Shopify store ---
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07

# --- Auth: pick ONE ---
# Option A: Dev Dashboard app credentials (client credentials grant, token auto-refreshes)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B: a static Admin API access token (shpat_...)
SHOPIFY_ACCESS_TOKEN=

# Location whose stock is synced (gid://shopify/Location/...). Run `npm run check` to list them.
SHOPIFY_LOCATION_ID=

# --- This app ---
PORT=3000
# Public HTTPS URL that Shopify can reach (e.g. an ngrok / cloudflared tunnel)
PUBLIC_URL=https://example.trycloudflare.com
# Full reconcile every N seconds (catches missed webhooks). 0 disables.
RECONCILE_INTERVAL_SECONDS=300
